{
  "format": "minilang-notebook",
  "version": 1,
  "title": "sqlite_db.mnb",
  "cells": [
    {
      "id": "db-intro",
      "cell_type": "markdown",
      "source": "# SQLite Databases & Visualizations (`db` Module)\n\nMinilang includes a built-in **`db`** module backed by SQLite3 with zero setup required.\n\n### Core API\n- **`db::open(path?, mode?)`** — open an in-memory (`\":memory:\"`) or file-backed SQLite database (pass `\"ro\"` or `true` for read-only)\n- **`conn:exec(sql, params?)`** — execute DDL/DML statements (returns `{\"changes\", \"last_insert_rowid\"}`)\n- **`conn:query(sql, params?)`** / **`conn:one(sql, params?)`** — run `SELECT` queries returning a list of row maps (or a single map)\n- **Parameterized bindings** — pass positional `?` lists (`[...]`) or named `:key` / `@key` / `$key` maps (`{\"key\" is val}`)\n- **Transactions** — `conn:begin`, `conn:commit`, `conn:rollback`\n- **Introspection** — `conn:tables`, `conn:schema(name?)`, `conn:path`, `conn:close`\n- **One-shot helpers** — `db::query(path, sql, params?)` and `db::exec(path, sql, params?)`\n\n> **Tip:** To persist to disk, replace `db::open(\":memory:\")` with `db::open(\"analytics.sqlite\")` — you can then click the `.sqlite` file in the sidebar to open the built-in SQLite Browser!",
      "execution_count": null,
      "output": null
    },
    {
      "id": "db-schema-seed",
      "cell_type": "code",
      "source": ":> 1. Open a SQLite database, create tables, test rollback, and seed data in a transaction\nlet conn := db::open(\":memory:\")\n\nconn:exec(\"\n    CREATE TABLE products (\n        id INTEGER PRIMARY KEY,\n        name TEXT NOT NULL,\n        category TEXT NOT NULL,\n        unit_price REAL NOT NULL\n    );\n    CREATE TABLE orders (\n        id INTEGER PRIMARY KEY AUTOINCREMENT,\n        product_id INTEGER NOT NULL REFERENCES products(id),\n        region TEXT NOT NULL,\n        month TEXT NOT NULL,\n        qty INTEGER NOT NULL,\n        status TEXT NOT NULL\n    );\n    CREATE INDEX idx_orders_month ON orders(month);\n    CREATE INDEX idx_orders_region ON orders(region);\n\")\n\n:> Verify transactions: insert a dummy row and roll it back\nconn:begin\nconn:exec(\"INSERT INTO products (id, name, category, unit_price) VALUES (?, ?, ?, ?)\", [999, \"Rolled Back\", \"Test\", 1.0])\nconn:rollback\n\n:> Seed products with positional (?) parameters\nlet catalog := [\n    [1, \"Edge Gateway Pro\",   \"Hardware\", 320.0],\n    [2, \"Sensor Hub Mini\",    \"Hardware\", 110.0],\n    [3, \"Telemetry Cloud\",    \"SaaS\",     180.0],\n    [4, \"Anomaly Guard AI\",   \"SaaS\",     260.0],\n    [5, \"Query Accelerator\",  \"Add-on\",    75.0],\n    [6, \"Audit Archive Pack\", \"Add-on\",    95.0]\n]\n\nconn:begin\nfor p in catalog do\n    conn:exec(\"INSERT INTO products (id, name, category, unit_price) VALUES (?, ?, ?, ?)\", p)\nend\n\n:> Seed 36 monthly orders across 3 regions using named (:param) bindings\nlet months := [\"Jan\", \"Feb\", \"Mar\", \"Apr\", \"May\", \"Jun\"]\nlet regions := [\"NA\", \"EU\", \"APAC\"]\nfor mi in 1 .. months:count do\n    let m := months[mi]\n    for ri in 1 .. regions:count do\n        let reg := regions[ri]\n        for k in 1 .. 2 do\n            let pid := ((mi + ri + k) % 6) + 1\n            let qty := 4 + ((mi * 3 + ri * 5 + k * 2) % 14)\n            let st := if (mi + ri + k) % 9 = 0 then \"refunded\" else \"completed\" end\n            conn:exec(\n                \"INSERT INTO orders (product_id, region, month, qty, status) VALUES (:pid, :region, :month, :qty, :status)\",\n                {\"pid\" is pid, \"region\" is reg, \"month\" is m, \"qty\" is qty, \"status\" is st}\n            )\n        end\n    end\nend\nconn:commit\n\nprintln('Opened {conn} with tables: {conn:tables}')\ntable(conn:schema, \"Database Schema (sqlite_master)\")",
      "execution_count": null,
      "output": null
    },
    {
      "id": "db-queries-tables",
      "cell_type": "code",
      "source": ":> 2. Parameterized SQL queries (conn:one & conn:query) rendered directly with table()\nlet kpis := conn:one(\"\n    SELECT\n        COUNT(*) AS completed_orders,\n        SUM(o.qty) AS total_units,\n        ROUND(SUM(o.qty * p.unit_price), 2) AS total_revenue,\n        ROUND(AVG(o.qty * p.unit_price), 2) AS avg_order_value\n    FROM orders o\n    JOIN products p ON p.id = o.product_id\n    WHERE o.status = :status\n\", {\"status\" is \"completed\"})\n\ntable(kpis, \"Executive KPIs (Completed Orders)\")\n\nlet top_orders := conn:query(\"\n    SELECT\n        o.id AS order_id,\n        o.month,\n        o.region,\n        p.name AS product,\n        p.category,\n        o.qty,\n        p.unit_price,\n        ROUND(o.qty * p.unit_price, 2) AS revenue\n    FROM orders o\n    JOIN products p ON p.id = o.product_id\n    WHERE o.status = :status AND (o.qty * p.unit_price) >= :min_rev\n    ORDER BY revenue DESC\n\", {\"status\" is \"completed\", \"min_rev\" is 1000.0})\n\ntable(top_orders, 'High-Value Orders (>= $1,000) — {top_orders:count} rows')",
      "execution_count": null,
      "output": null
    },
    {
      "id": "db-charts-cat-region",
      "cell_type": "code",
      "source": ":> 3. SQL GROUP BY aggregations -> Bar & Pie charts\nlet by_category := conn:query(\"\n    SELECT\n        p.category,\n        ROUND(SUM(o.qty * p.unit_price), 2) AS revenue,\n        SUM(o.qty) AS units\n    FROM orders o\n    JOIN products p ON p.id = o.product_id\n    WHERE o.status = 'completed'\n    GROUP BY p.category\n    ORDER BY revenue DESC\n\")\n\nchart({\n    \"type\" is \"bar\",\n    \"title\" is \"Completed Revenue by Product Category ($)\",\n    \"data\" is by_category,\n    \"x\" is \"category\",\n    \"y\" is \"revenue\"\n})\n\nlet by_region := conn:query(\"\n    SELECT\n        o.region,\n        ROUND(SUM(o.qty * p.unit_price), 2) AS revenue\n    FROM orders o\n    JOIN products p ON p.id = o.product_id\n    WHERE o.status = 'completed'\n    GROUP BY o.region\n    ORDER BY revenue DESC\n\")\n\nlet region_pie := {}\nfor r in by_region do\n    region_pie[r[\"region\"]] := r[\"revenue\"]\nend\nchart(\"pie\", region_pie, \"Revenue Share by Region ($)\")",
      "execution_count": null,
      "output": null
    },
    {
      "id": "db-charts-trend-scatter",
      "cell_type": "code",
      "source": ":> 4. SQL time-series pivot -> Multi-series Area chart & Price/Demand Scatter plot\nlet monthly_pivot := conn:query(\"\n    SELECT\n        o.month,\n        ROUND(SUM(CASE WHEN o.region = 'NA'   THEN o.qty * p.unit_price ELSE 0 END), 2) AS na,\n        ROUND(SUM(CASE WHEN o.region = 'EU'   THEN o.qty * p.unit_price ELSE 0 END), 2) AS eu,\n        ROUND(SUM(CASE WHEN o.region = 'APAC' THEN o.qty * p.unit_price ELSE 0 END), 2) AS apac\n    FROM orders o\n    JOIN products p ON p.id = o.product_id\n    WHERE o.status = 'completed'\n    GROUP BY o.month\n    ORDER BY CASE o.month\n        WHEN 'Jan' THEN 1 WHEN 'Feb' THEN 2 WHEN 'Mar' THEN 3\n        WHEN 'Apr' THEN 4 WHEN 'May' THEN 5 WHEN 'Jun' THEN 6 ELSE 7 END\n\")\n\nchart({\n    \"type\" is \"area\",\n    \"title\" is \"Monthly Revenue by Region ($)\",\n    \"data\" is monthly_pivot,\n    \"x\" is \"month\",\n    \"y\" is [\"na\", \"eu\", \"apac\"]\n})\n\nlet prod_perf := conn:query(\"\n    SELECT\n        p.name,\n        p.unit_price,\n        SUM(o.qty) AS total_units,\n        ROUND(SUM(o.qty * p.unit_price), 2) AS total_revenue\n    FROM products p\n    JOIN orders o ON o.product_id = p.id\n    WHERE o.status = 'completed'\n    GROUP BY p.id\n    ORDER BY p.unit_price\n\")\n\nlet pts := list(prod_perf; r) {\"x\" is r[\"unit_price\"], \"y\" is r[\"total_units\"], \"label\" is r[\"name\"]}\nchart({\n    \"type\" is \"scatter\",\n    \"title\" is \"Unit Price ($) vs Total Units Sold\",\n    \"series\" is [{\"name\" is \"Products\", \"data\" is pts}]\n})",
      "execution_count": null,
      "output": null
    },
    {
      "id": "db-interactive-dashboard",
      "cell_type": "code",
      "source": ":> 5. Interactive SQL-powered dashboard (ui::select + ui::chart + ui::table)\nlet all_rows := conn:query(\"\n    SELECT\n        o.id AS order_id,\n        o.month,\n        o.region,\n        p.name AS product,\n        p.category,\n        o.qty,\n        ROUND(o.qty * p.unit_price, 2) AS revenue\n    FROM orders o\n    JOIN products p ON p.id = o.product_id\n    WHERE o.status = 'completed'\n    ORDER BY o.id\n\")\n\nlet cat_by_region := {\n    \"All\" is by_category,\n    \"NA\" is conn:query(\"SELECT p.category, ROUND(SUM(o.qty * p.unit_price), 2) AS revenue FROM orders o JOIN products p ON p.id = o.product_id WHERE o.status = 'completed' AND o.region = ? GROUP BY p.category ORDER BY revenue DESC\", [\"NA\"]),\n    \"EU\" is conn:query(\"SELECT p.category, ROUND(SUM(o.qty * p.unit_price), 2) AS revenue FROM orders o JOIN products p ON p.id = o.product_id WHERE o.status = 'completed' AND o.region = ? GROUP BY p.category ORDER BY revenue DESC\", [\"EU\"]),\n    \"APAC\" is conn:query(\"SELECT p.category, ROUND(SUM(o.qty * p.unit_price), 2) AS revenue FROM orders o JOIN products p ON p.id = o.product_id WHERE o.status = 'completed' AND o.region = ? GROUP BY p.category ORDER BY revenue DESC\", [\"APAC\"])\n}\n\nlet summary_badge := ui::badge('{all_rows:count} completed orders · Region: All')\nlet dash_chart := ui::chart({\n    \"type\" is \"bar\",\n    \"title\" is \"Category Revenue — All Regions ($)\",\n    \"data\" is cat_by_region[\"All\"],\n    \"x\" is \"category\",\n    \"y\" is \"revenue\"\n})\nlet dash_table := ui::table(all_rows, \"Completed Orders (All Regions)\")\n\nlet region_select := ui::select([\"All\", \"NA\", \"EU\", \"APAC\"], \"All\"; reg) do\n    let rows := []\n    for r in all_rows do\n        if reg = \"All\" then\n            rows:put(r)\n        elseif r[\"region\"] = reg then\n            rows:put(r)\n        end\n    end\n    dash_chart:set_spec({\n        \"type\" is \"bar\",\n        \"title\" is 'Category Revenue — {reg} ($)',\n        \"data\" is cat_by_region[reg],\n        \"x\" is \"category\",\n        \"y\" is \"revenue\"\n    })\n    dash_table:set_data(rows)\n    summary_badge:set_text('{rows:count} completed orders · Region: {reg}')\nend\n\nui::show(ui::card(\"SQLite Sales Explorer\",\n    ui::vbox(\n        ui::hbox(ui::label(\"Filter Region:\"), region_select, summary_badge),\n        dash_chart,\n        dash_table\n    )\n))",
      "execution_count": null,
      "output": null
    }
  ]
}
